{
  "name": "sublink-frontend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/write-build-info.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:d1:create": "wrangler d1 create sublink",
    "cf:d1:migrate:local": "wrangler d1 migrations apply sublink --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply sublink --remote",
    "cf:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "shadcn": "^4.13.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wrangler": "^4.24.3"
  }
}
