{
  "name": "sublink",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "cf:dev": "npm --prefix frontend run cf:dev",
    "cf:d1:create": "npm --prefix frontend run cf:d1:create",
    "cf:d1:migrate:local": "npm --prefix frontend run cf:d1:migrate:local",
    "cf:d1:migrate:remote": "npm --prefix frontend run cf:d1:migrate:remote",
    "cf:deploy": "npm --prefix frontend run cf:deploy"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2"
  }
}
